        </div>
        <div>
          <h4>聯絡</h4>
          <ul>
            <li>WhatsApp / 電話：+852 9xxxxxxx</li>
            <li>Email：hello@eclatreborn.example</li>
          </ul>
        </div>
        <div>
          <h4>資訊</h4>
          <ul>
            <li>回收條款與細則</li>
            <li>私隱政策</li>
          </ul>
        </div>
      </div>
      <div class="copy">© <span id="y"></span> Éclat Reborn</div>
    </div>
  </footer>

  <script>document.getElementById('y').textContent = new Date().getFullYear();</script>
  <script src="/public/js/pricing.js" defer></script>

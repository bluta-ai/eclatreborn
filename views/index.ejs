
<section class="hero" style="background-image:url('https://images.unsplash.com/photo-1612832021429-72df8333bd3b?auto=format&fit=crop&w=1600&q=80');">
  <div class="hero-overlay">
    <div class="container hero-inner">
      <h1 class="headline">高端二手水晶回收</h1>
      <p class="subhead">為您的水晶賦予新價值。透明、專業、值得信賴。</p>
      <div class="hero-cta">
        <a class="btn-primary" href="#get-offer">開始估價</a>
      </div>
    </div>
  </div>
</section>

<section id="how-it-works" class="container section">
  <h2 class="h-title">流程</h2>
  <div class="steps">
    <div class="step"><div class="dot">1</div><div><h3>提交資料</h3><p>上載相片與水晶資訊。</p></div></div>
    <div class="step"><div class="dot">2</div><div><h3>即時估值</h3><p>系統快速計算參考回收價。</p></div></div>
    <div class="step"><div class="dot">3</div><div><h3>專業檢驗</h3><p>專員精細檢查，確認價值。</p></div></div>
    <div class="step"><div class="dot">4</div><div><h3>快速收款</h3><p>成交即時付款，安全可靠。</p></div></div>
  </div>
</section>

<section id="get-offer" class="container section card">
  <div class="form-head">
    <h2 class="h-title">即時估價</h2>
    <p class="muted">僅供參考，最終以專員檢驗為準。</p>
  </div>
  <form action="/quote" method="POST" enctype="multipart/form-data" class="form-grid">
    <% if (typeof errors !== 'undefined') { %>
      <div class="alert"><ul><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul></div>
    <% } %>
    <div class="grid two">
      <div><label>姓名*</label><input name="name" required></div>
      <div><label>電郵*</label><input name="email" type="email" required></div>
    </div>
    <div class="grid three">
      <div><label>種類*</label><select name="type" id="type"><option value="amethyst">紫水晶</option><option value="rose_quartz">粉晶</option><option value="clear_quartz">白水晶</option><option value="citrine">黃水晶</option><option value="black_onyx">黑瑪瑙</option><option value="aquamarine">海藍寶</option><option value="jade">玉</option><option value="tourmaline">碧璽</option><option value="others">其他</option></select></div>
      <div><label>重量(g)</label><input name="weight" id="weight" type="number" min="0"></div>
      <div><label>狀況</label><select name="condition" id="condition"><option value="mint">近全新</option><option value="good" selected>良好</option><option value="fair">一般</option><option value="poor">損耗</option></select></div>
    </div>
    <div class="grid two">
      <div><label>尺寸</label><select name="size" id="size"><option value="xs">迷你</option><option value="s">小</option><option value="m" selected>中</option><option value="l">大</option><option value="xl">特大</option></select></div>
      <div><label>電話</label><input name="phone"></div>
    </div>
    <div><label>相片</label><input type="file" name="photos" accept="image/*" multiple></div>
    <div><label>備註</label><textarea name="notes" rows="3"></textarea></div>
    <div class="estimate end">
      <div><div class="est-label">即時參考價</div><div class="est-value"><span id="estPrice">$0</span> HKD</div></div>
      <button class="btn-primary" type="submit">提交</button>
    </div>
  </form>
</section>

<section id="faqs" class="container section">
  <h2 class="h-title">常見問題</h2>
  <details><summary>估價可靠嗎？</summary><p>系統即時計算，專員會再次檢驗確認。</p></details>
  <details><summary>付款快嗎？</summary><p>成交後即時轉數快或銀行轉帳。</p></details>
  <details><summary>不成交會怎樣？</summary><p>不成交可免費原件退回。</p></details>
</section>


<% layout('layout') -%>
<section class="container section card">
  <h1>已收到您的估價申請 ✅</h1>
  <p>感謝您，<b><%= data.name %></b>。以下為摘要：</p>
  <ul>
    <li>Email: <%= data.email %></li>
    <% if (data.phone) { %><li>電話: <%= data.phone %></li><% } %>
    <li>種類: <%= data.type %></li>
    <% if (data.weight) { %><li>重量: <%= data.weight %>g</li><% } %>
    <li>狀況: <%= data.condition %></li>
    <li>尺寸: <%= data.size %></li>
  </ul>
  <p>系統估價：<b>$<%= data.price %> HKD</b></p>
  <% if (data.images.length) { %>
    <h3>上載相片</h3>
    <div class="gallery">
      <% data.images.forEach(img=>{ %><img src="<%= img.url %>" alt="上載相片"><% }) %>
    </div>
  <% } %>
  <a class="btn-primary" href="/">返回首頁</a>
</section>
